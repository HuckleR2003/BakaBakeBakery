:root {
    --flour: rgb(244, 229, 198);
    --paper: rgb(250, 239, 216);
    --crust: rgb(200, 117, 61);
    --cocoa: rgb(56, 40, 36);
    --sage: rgb(113, 129, 107);
    --cherry: rgb(168, 77, 70);
    --glow: rgb(255, 180, 93);
    --blue: rgb(82, 103, 119);
}

.hud {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: var(--cocoa);
}

.top-row {
    position: absolute;
    top: 20px;
    left: 24px;
    right: 24px;
    height: 76px;
    flex-direction: row;
    align-items: stretch;
}

.bakery-mark,
.metric-strip,
    .milestone-card,
    .ledger-button,
    .guide-button,
.warmth-card,
.work-card,
.recipe-dock,
.ledger {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 3px;
    border-left-color: rgba(56, 40, 36, 0.4);
    border-right-color: rgba(56, 40, 36, 0.4);
    border-top-color: rgba(56, 40, 36, 0.38);
    border-bottom-color: rgba(56, 40, 36, 0.68);
}

.bakery-mark {
    width: 176px;
    padding: 10px 14px;
    margin-right: 9px;
    justify-content: center;
    background-color: rgba(56, 40, 36, 0.94);
    border-radius: 10px;
}

.bakery-mark-name {
    color: var(--flour);
    font-size: 17px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.bakery-mark-level {
    margin-top: 5px;
    color: rgba(244, 229, 198, 0.62);
    font-size: 8px;
    letter-spacing: 1px;
}

.metric-strip {
    flex-direction: row;
    margin-right: 9px;
    padding: 6px;
    background-color: rgba(244, 229, 198, 0.94);
    border-radius: 10px;
}

.metric-card {
    width: 106px;
    padding: 4px 10px;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: rgba(56, 40, 36, 0.16);
}

.metric-card--last {
    border-right-width: 0;
}

.metric-card--small {
    width: 88px;
}

.metric-label,
.dock-kicker,
.work-kicker,
.warmth-title {
    font-size: 9px;
    letter-spacing: 1.5px;
    color: rgba(56, 40, 36, 0.68);
    -unity-font-style: bold;
}

.metric-value {
    margin-top: 2px;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--cocoa);
}

.metric-value--small {
    font-size: 19px;
}

.milestone-card {
    width: 290px;
    padding: 10px 15px;
    margin-right: 9px;
    background-color: rgba(250, 239, 216, 0.96);
    border-radius: 10px;
}

.milestone-value {
    margin-top: 6px;
    font-size: 13px;
    -unity-font-style: bold;
}

.thin-progress,
.action-progress,
.warmth-track {
    overflow: hidden;
    background-color: rgba(56, 40, 36, 0.14);
    border-radius: 99px;
}

.thin-progress {
    height: 5px;
    margin-top: 7px;
}

.thin-progress-fill,
.action-progress-fill,
.warmth-fill {
    width: 0;
    height: 100%;
    background-color: var(--crust);
    border-radius: 99px;
}

.ledger-button {
    width: 142px;
    margin-left: auto;
    padding-left: 15px;
    padding-right: 15px;
    background-color: rgba(56, 40, 36, 0.95);
    color: var(--flour);
    border-radius: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.guide-button {
    width: 94px;
    margin-left: 9px;
    padding: 8px 12px;
    background-color: rgba(113, 129, 107, 0.96);
    color: var(--flour);
    border-radius: 10px;
    border-bottom-color: rgb(60, 73, 58);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.guide-button:hover,
.guide-button:focus {
    background-color: rgb(132, 149, 123);
    border-bottom-color: var(--glow);
}

.day-board {
    width: 176px;
    margin-right: 9px;
    padding: 8px 12px;
    background-color: rgb(105, 68, 43);
    color: var(--flour);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 5px;
    border-color: rgb(67, 43, 31);
    border-bottom-color: rgb(48, 31, 24);
    border-radius: 8px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.day-board:hover,
.day-board:focus {
    background-color: rgb(128, 82, 49);
    border-top-color: var(--glow);
}

.ledger-button:hover,
.ledger-button:focus {
    background-color: rgb(78, 55, 48);
    border-bottom-color: var(--glow);
}

.warmth-card {
    position: absolute;
    top: 108px;
    left: 24px;
    width: 246px;
    min-height: 106px;
    padding: 12px 14px;
    background-color: rgba(250, 239, 216, 0.9);
    border-radius: 10px;
}

.warmth-heading {
    flex-direction: row;
    justify-content: space-between;
}

.warmth-value {
    font-size: 11px;
    -unity-font-style: bold;
}

.warmth-track {
    height: 8px;
    margin-top: 9px;
}

.warmth-fill {
    background-color: var(--cherry);
}

.customer-value {
    margin-top: 7px;
    font-size: 11px;
    color: rgba(56, 40, 36, 0.65);
}

.golden-chip {
    display: none;
    margin-top: 8px;
    padding: 5px 8px;
    background-color: rgba(255, 180, 93, 0.28);
    border-radius: 5px;
}

.golden-chip--visible {
    display: flex;
}

.golden-value {
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.speech-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.speech-bubble {
    position: absolute;
    max-width: 260px;
    min-width: 155px;
    padding: 10px 13px 12px 13px;
    opacity: 0;
    scale: 0.94 0.94;
    background-color: rgba(250, 239, 216, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 3px;
    border-color: rgba(56, 40, 36, 0.36);
    border-bottom-color: rgba(56, 40, 36, 0.62);
    border-radius: 12px;
    transition-property: opacity, scale, translate;
    transition-duration: 180ms;
}

.speech-bubble--visible {
    opacity: 1;
    scale: 1 1;
    translate: 0 -5px;
}

.speech-bubble--baker {
    left: 39%;
    top: 34%;
}

.speech-bubble--grandmother {
    right: 12%;
    top: 45%;
}

.speech-bubble--neighbour {
    left: 10%;
    top: 53%;
}

.speech-bubble--friend {
    left: 22%;
    top: 28%;
    max-width: 330px;
    background-color: rgba(246, 231, 207, 0.93);
    border-left-width: 5px;
    border-left-color: var(--sage);
}

.speaker-name {
    color: var(--cherry);
    font-size: 8px;
    letter-spacing: 1.4px;
    -unity-font-style: bold;
}

.speech-copy {
    margin-top: 4px;
    white-space: normal;
    font-size: 12px;
    -unity-font-style: bold;
}

.bubble-tail {
    position: absolute;
    width: 13px;
    height: 13px;
    left: 28px;
    bottom: -8px;
    rotate: 45deg;
    background-color: rgba(250, 239, 216, 0.86);
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(56, 40, 36, 0.42);
}

.tutorial-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.tutorial-card {
    display: none;
    position: absolute;
    top: 112px;
    right: 24px;
    width: 414px;
    min-height: 390px;
    padding: 20px;
    background-color: rgba(39, 29, 28, 0.985);
    color: var(--flour);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 7px;
    border-color: rgba(244, 229, 198, 0.3);
    border-left-color: var(--sage);
    border-left-width: 7px;
    border-bottom-color: rgb(18, 14, 15);
    border-radius: 18px;
}

.tutorial-card--visible {
    display: flex;
}

.tutorial-heading {
    height: 66px;
    flex-direction: row;
    align-items: center;
}

.mila-portrait {
    width: 58px;
    height: 58px;
    margin-right: 13px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(190, 178, 145);
    border-width: 3px;
    border-color: rgba(255, 180, 93, 0.72);
    border-radius: 99px;
}

.mila-face {
    position: absolute;
    top: 17px;
    left: 13px;
    width: 32px;
    height: 35px;
    background-color: rgb(224, 174, 139);
    border-radius: 47% 47% 42% 42%;
}

.mila-hair {
    position: absolute;
    top: 4px;
    left: 8px;
    width: 43px;
    height: 31px;
    background-color: rgb(83, 51, 38);
    border-radius: 52% 52% 32% 32%;
}

.mila-eye {
    position: absolute;
    top: 13px;
    width: 4px;
    height: 5px;
    background-color: var(--cocoa);
    border-radius: 99px;
}

.mila-eye--left { left: 7px; }
.mila-eye--right { right: 7px; }

.mila-smile {
    position: absolute;
    left: 12px;
    bottom: 7px;
    width: 9px;
    height: 5px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(151, 72, 68);
    border-radius: 99px;
}

.tutorial-heading-copy {
    justify-content: center;
}

.tutorial-speaker {
    color: var(--glow);
    font-size: 10px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
}

.tutorial-progress {
    margin-top: 5px;
    color: rgba(244, 229, 198, 0.48);
    font-size: 8px;
    letter-spacing: 1.2px;
}

.tutorial-title {
    margin-top: 10px;
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
}

.tutorial-copy {
    margin-top: 10px;
    color: rgba(244, 229, 198, 0.78);
    font-size: 12px;
    white-space: normal;
}

.tutorial-objective-card {
    margin-top: 15px;
    padding: 11px 13px;
    background-color: rgba(113, 129, 107, 0.18);
    border-left-width: 4px;
    border-left-color: var(--sage);
    border-radius: 7px;
}

.tutorial-objective-kicker {
    color: rgba(255, 180, 93, 0.82);
    font-size: 8px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.tutorial-objective {
    margin-top: 5px;
    color: var(--flour);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.tutorial-day-summary {
    display: none;
    margin-top: 10px;
    padding: 8px 10px;
    color: var(--glow);
    background-color: rgba(255, 180, 93, 0.08);
    border-radius: 6px;
    font-size: 9px;
    letter-spacing: 0.7px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.tutorial-replies {
    height: 48px;
    margin-top: 16px;
    flex-direction: row;
}

.tutorial-reply {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 7px;
    padding: 7px 9px;
    border-radius: 7px;
    font-size: 9px;
    letter-spacing: 0.4px;
    -unity-font-style: bold;
    white-space: normal;
}

.tutorial-reply--primary {
    color: var(--cocoa);
    background-color: var(--glow);
    border-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: rgb(159, 91, 43);
}

.tutorial-reply--secondary {
    color: rgba(244, 229, 198, 0.72);
    background-color: rgba(244, 229, 198, 0.06);
    border-width: 1px;
    border-color: rgba(244, 229, 198, 0.25);
}

.tutorial-reply:hover,
.tutorial-reply:focus {
    translate: 0 -2px;
    border-color: var(--glow);
}

.tutorial-ribbon {
    display: none;
    position: absolute;
    top: 108px;
    right: 24px;
    width: 410px;
    min-height: 48px;
    padding: 9px 14px;
    color: var(--flour);
    background-color: rgba(39, 29, 28, 0.94);
    border-left-width: 5px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 4px;
    border-left-color: var(--sage);
    border-right-color: rgba(244, 229, 198, 0.2);
    border-top-color: rgba(244, 229, 198, 0.2);
    border-bottom-color: rgb(18, 14, 15);
    border-radius: 10px;
    font-size: 9px;
    -unity-font-style: bold;
    white-space: normal;
}

.tutorial-ribbon--visible {
    display: flex;
}

.tutorial-target {
    scale: 1.04 1.04;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-left-color: var(--glow);
    border-right-color: var(--glow);
    border-top-color: var(--glow);
    transition-property: scale, border-color, background-color;
    transition-duration: 180ms;
}

.toast {
    position: absolute;
    top: 112px;
    left: 50%;
    width: 390px;
    min-height: 66px;
    margin-left: -195px;
    flex-direction: row;
    opacity: 0;
    translate: 0 -18px;
    padding: 10px 13px;
    background-color: rgba(56, 40, 36, 0.96);
    border-radius: 10px;
    transition-property: opacity, translate;
    transition-duration: 190ms;
}

.toast--visible {
    opacity: 1;
    translate: 0 0;
}

.toast-mark {
    width: 7px;
    margin-right: 12px;
    background-color: var(--glow);
    border-radius: 99px;
}

.toast-copy-wrap {
    flex-grow: 1;
    justify-content: center;
}

.toast-title {
    color: var(--flour);
    font-size: 11px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
}

.toast-copy {
    margin-top: 4px;
    color: rgba(244, 229, 198, 0.72);
    font-size: 11px;
    white-space: normal;
}

.ledger {
    position: absolute;
    top: 106px;
    right: 24px;
    width: 388px;
    min-height: 372px;
    padding: 22px;
    background-color: rgba(250, 239, 216, 0.98);
    border-left-width: 7px;
    border-left-color: var(--cherry);
    border-radius: 10px;
}

.ledger--closed {
    display: none;
}

.ledger-heading-row {
    flex-direction: row;
    justify-content: space-between;
}

.ledger-heading {
    font-size: 19px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.ledger-copy {
    margin-top: 6px;
    font-size: 11px;
    color: rgba(56, 40, 36, 0.64);
}

.ledger-stamp {
    padding: 6px 8px;
    color: var(--cherry);
    border-width: 1px;
    border-color: rgba(168, 77, 70, 0.52);
    border-radius: 4px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.ledger-divider {
    height: 1px;
    margin-top: 17px;
    margin-bottom: 12px;
    background-color: rgba(56, 40, 36, 0.2);
}

.upgrade-card {
    margin-top: 8px;
    padding: 12px;
    background-color: rgba(200, 117, 61, 0.08);
    border-radius: 7px;
}

.upgrade-name {
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.upgrade-detail {
    margin-top: 5px;
    white-space: normal;
    font-size: 11px;
    color: rgba(56, 40, 36, 0.67);
}

.upgrade-button {
    height: 34px;
    margin-top: 10px;
    background-color: var(--cocoa);
    color: var(--flour);
    border-width: 0;
    border-radius: 5px;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.upgrade-button:disabled {
    opacity: 0.5;
}

.ledger-footnote {
    margin-top: 13px;
    font-size: 9px;
    color: rgba(56, 40, 36, 0.46);
    -unity-text-align: middle-right;
}

.work-card {
    position: absolute;
    left: 24px;
    bottom: 208px;
    width: 470px;
    min-height: 112px;
    padding: 14px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(250, 239, 216, 0.95);
    border-radius: 11px;
}

.market-map {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 680px;
    height: 310px;
    margin-left: -340px;
    margin-top: -180px;
    padding: 20px 26px;
    background-color: rgba(39, 29, 28, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 7px;
    border-color: rgba(244, 229, 198, 0.28);
    border-bottom-color: rgb(20, 16, 17);
    border-radius: 18px;
}

.market-map--visible {
    display: flex;
}

.map-kicker {
    color: var(--glow);
    letter-spacing: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.map-landscape {
    position: relative;
    height: 174px;
    margin-top: 12px;
    overflow: hidden;
    background-color: rgba(89, 112, 91, 0.18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(244, 229, 198, 0.14);
    border-radius: 13px;
}

.map-hill {
    position: absolute;
    bottom: -92px;
    width: 330px;
    height: 170px;
    background-color: rgba(113, 135, 111, 0.3);
    border-radius: 50%;
}

.map-hill--left { left: -50px; }
.map-hill--right { right: -34px; bottom: -104px; background-color: rgba(67, 94, 78, 0.42); }

.map-route {
    position: absolute;
    left: 91px;
    right: 103px;
    top: 80px;
    height: 16px;
    margin: 0;
    background-color: rgba(244, 229, 198, 0.12);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(244, 229, 198, 0.13);
    border-radius: 99px;
    rotate: -2deg;
}

.map-route-fill {
    width: 0;
    height: 100%;
    background-color: var(--crust);
    border-radius: 99px;
}

.bike-marker {
    position: absolute;
    left: -18px;
    top: -15px;
    width: 56px;
    height: 42px;
    flex-direction: row;
    align-items: flex-end;
}

.map-village,
.map-town {
    position: absolute;
    top: 27px;
    width: 88px;
    align-items: center;
}

.map-village { left: 14px; }
.map-town { right: 8px; top: 22px; }

.map-house {
    width: 55px;
    height: 49px;
    margin-top: 13px;
    align-items: center;
    justify-content: flex-end;
    background-color: var(--flour);
    border-bottom-width: 5px;
    border-bottom-color: rgb(128, 74, 44);
    border-radius: 5px;
}

.map-house-roof {
    position: absolute;
    top: -13px;
    width: 48px;
    height: 27px;
    background-color: var(--cherry);
    rotate: 45deg;
    border-radius: 4px;
}

.map-house-window {
    width: 15px;
    height: 18px;
    margin-bottom: 7px;
    background-color: var(--glow);
    border-width: 2px;
    border-color: var(--cocoa);
}

.map-stall-roof {
    width: 72px;
    height: 17px;
    background-color: var(--cherry);
    border-left-width: 8px;
    border-right-width: 8px;
    border-color: var(--flour);
    border-radius: 4px;
}

.map-stall-body {
    width: 62px;
    height: 45px;
    padding: 8px;
    flex-direction: row;
    justify-content: space-between;
    background-color: rgb(118, 73, 46);
}

.map-stall-crate {
    width: 19px;
    height: 21px;
    background-color: var(--crust);
    border-bottom-width: 4px;
    border-bottom-color: rgb(112, 61, 36);
}

.map-place-label {
    margin-top: 7px;
    color: var(--glow);
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.map-tree {
    position: absolute;
    top: 41px;
    width: 34px;
    height: 65px;
    align-items: center;
}

.map-tree--one { left: 192px; }
.map-tree--two { right: 206px; top: 53px; scale: 0.8; }

.map-tree-crown {
    width: 34px;
    height: 34px;
    background-color: var(--sage);
    border-radius: 50%;
}

.map-tree-trunk {
    width: 7px;
    height: 28px;
    background-color: var(--crust);
}

.bike-wheel {
    width: 18px;
    height: 18px;
    border-width: 4px;
    border-color: var(--flour);
    border-radius: 99px;
}

.bike-frame {
    width: 20px;
    height: 12px;
    margin-left: -3px;
    margin-right: -3px;
    margin-bottom: 6px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-color: var(--cherry);
}

.map-labels {
    margin-top: 8px;
    flex-direction: row;
    justify-content: space-between;
    color: rgba(244, 229, 198, 0.72);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.map-status {
    margin-top: 8px;
    color: rgba(244, 229, 198, 0.52);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.bottom-shell {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 14px;
    height: 180px;
    flex-direction: row;
    background-color: rgba(42, 30, 29, 0.97);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 5px;
    border-color: rgba(244, 229, 198, 0.24);
    border-bottom-color: rgba(20, 16, 17, 0.92);
    border-radius: 16px;
    overflow: hidden;
}

.nav-rail {
    width: 88px;
    padding: 12px 9px;
    background-color: rgba(20, 16, 17, 0.48);
    border-right-width: 1px;
    border-right-color: rgba(244, 229, 198, 0.12);
}

.nav-button {
    flex-grow: 1;
    margin: 3px 0;
    background-color: transparent;
    color: rgba(244, 229, 198, 0.55);
    border-width: 1px;
    border-color: transparent;
    border-radius: 9px;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
}

.nav-button--active {
    color: var(--flour);
    background-color: rgba(200, 117, 61, 0.24);
    border-color: rgba(255, 180, 93, 0.48);
    border-left-width: 4px;
    border-left-color: var(--glow);
}

.nav-label {
    margin-top: 8px;
    color: rgba(244, 229, 198, 0.58);
    font-size: 8px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.nav-button--active .nav-label {
    color: var(--flour);
}

.nav-home-icon,
.nav-craft-icon {
    width: 35px;
    height: 32px;
    align-items: center;
    justify-content: flex-end;
}

.nav-home-roof {
    position: absolute;
    top: 3px;
    width: 24px;
    height: 24px;
    rotate: 45deg;
    background-color: rgba(244, 229, 198, 0.58);
    border-radius: 3px;
}

.nav-home-body {
    width: 29px;
    height: 20px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(244, 229, 198, 0.58);
    border-radius: 3px;
}

.nav-home-door {
    width: 8px;
    height: 12px;
    background-color: rgb(67, 43, 37);
}

.nav-craft-loop {
    position: absolute;
    top: 0;
    width: 25px;
    height: 25px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-color: rgba(244, 229, 198, 0.58);
    border-radius: 50%;
}

.nav-craft-handle {
    width: 7px;
    height: 18px;
    margin-right: -21px;
    margin-bottom: -4px;
    rotate: -38deg;
    background-color: rgba(244, 229, 198, 0.58);
    border-radius: 5px;
}

.nav-button--active .nav-home-roof,
.nav-button--active .nav-home-body,
.nav-button--active .nav-craft-handle {
    background-color: var(--glow);
}

.nav-button--active .nav-craft-loop {
    border-color: var(--glow);
}

.dock-panel {
    flex-grow: 1;
    padding: 10px 14px;
}

.dock-panel--hidden {
    display: none;
}

.home-content {
    height: 100%;
    flex-direction: row;
}

.home-content--mature {
    flex-direction: column;
}

.unlock-banner {
    width: 38%;
    min-width: 315px;
    margin-right: 10px;
    padding: 13px 15px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(250, 239, 216, 0.95);
    border-left-width: 5px;
    border-left-color: var(--glow);
    border-radius: 10px;
}

.home-content--mature .unlock-banner {
    width: auto;
    min-width: 0;
    height: 54px;
    margin-right: 0;
    margin-bottom: 7px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.lock-mark {
    width: 40px;
    height: 50px;
    margin-right: 14px;
    align-items: center;
    justify-content: flex-end;
}

.home-content--mature .lock-mark {
    width: 28px;
    height: 34px;
    margin-right: 10px;
}

.lock-loop {
    position: absolute;
    top: 2px;
    width: 25px;
    height: 26px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-color: var(--cocoa);
    border-radius: 14px;
}

.lock-body {
    width: 34px;
    height: 30px;
    background-color: var(--crust);
    border-radius: 5px;
}

.home-content--mature .lock-loop {
    width: 18px;
    height: 18px;
    border-width: 3px;
}

.home-content--mature .lock-body {
    width: 26px;
    height: 22px;
}

.unlock-copy {
    flex-grow: 1;
}

.unlock-title {
    margin-top: 4px;
    color: var(--cocoa);
    font-size: 17px;
    -unity-font-style: bold;
}

.unlock-detail {
    margin-top: 2px;
    color: rgba(56, 40, 36, 0.62);
    font-size: 10px;
}

.home-content--mature .unlock-title {
    margin-top: 1px;
    font-size: 13px;
}

.home-content--mature .unlock-detail {
    position: absolute;
    right: 4px;
    top: 3px;
}

.unlock-progress {
    height: 7px;
    margin-top: 9px;
    overflow: hidden;
    background-color: rgba(56, 40, 36, 0.14);
    border-radius: 99px;
}

.home-content--mature .unlock-progress {
    height: 5px;
    margin-top: 4px;
}

.unlock-progress-fill {
    width: 0;
    height: 100%;
    background-color: var(--cherry);
    border-radius: 99px;
}

.recipe-scroll {
    flex-grow: 1;
    height: 100%;
}

.recipe-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.recipe-scroll .unity-scroll-view__vertical-scroller,
.recipe-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

.recipe-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: stretch;
    min-width: 100%;
}

.home-content--mature .recipe-scroll {
    height: 94px;
}

.recipe-scroll .recipe-card {
    display: none;
    width: 150px;
    min-width: 150px;
    height: 138px;
    flex-grow: 0;
    flex-basis: auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.home-content--mature .recipe-card {
    height: 82px;
}

.recipe-scroll .recipe-card--visible {
    display: flex;
}

.recipe-placeholder {
    min-width: 300px;
    flex-grow: 1;
    height: 138px;
    margin-left: 10px;
    padding: 18px 20px;
    flex-direction: row;
    align-items: center;
    color: rgba(244, 229, 198, 0.54);
    background-color: rgba(244, 229, 198, 0.035);
    border-width: 1px;
    border-color: rgba(244, 229, 198, 0.11);
    border-radius: 10px;
}

.recipe-placeholder-whisk {
    width: 45px;
    height: 72px;
    margin-right: 16px;
    rotate: -18deg;
}

.whisk-loop {
    position: absolute;
    top: 0;
    left: 8px;
    width: 30px;
    height: 44px;
    border-width: 3px;
    border-color: rgba(244, 229, 198, 0.3);
    border-radius: 50%;
}

.whisk-handle {
    position: absolute;
    left: 19px;
    bottom: 0;
    width: 9px;
    height: 34px;
    background-color: rgba(200, 117, 61, 0.6);
    border-radius: 5px;
}

.recipe-placeholder-title {
    color: rgba(255, 180, 93, 0.64);
    font-size: 9px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.recipe-placeholder-copy {
    width: 230px;
    margin-top: 7px;
    color: rgba(244, 229, 198, 0.42);
    font-size: 10px;
    white-space: normal;
}

.home-content--mature .recipe-placeholder {
    height: 82px;
}

.product-icon {
    width: 48px;
    height: 31px;
    margin-bottom: 5px;
    background-color: var(--crust);
    border-bottom-width: 4px;
    border-bottom-color: rgb(132, 72, 39);
    border-radius: 48% 48% 38% 38%;
}

.product-icon-detail {
    position: absolute;
    top: 5px;
    width: 5px;
    height: 19px;
    background-color: rgba(250, 239, 216, 0.78);
    border-radius: 99px;
    rotate: -18deg;
}

.product-icon-detail--0 { left: 12px; }
.product-icon-detail--1 { left: 22px; }
.product-icon-detail--2 { left: 32px; }

.product-icon--kaiserroll {
    width: 38px;
    height: 35px;
    border-radius: 99px;
}

.product-icon--kaiserroll .product-icon-detail {
    top: 15px;
    left: 9px;
    width: 21px;
    height: 3px;
    rotate: 0deg;
}

.product-icon--buttercroissant {
    width: 52px;
    height: 25px;
    border-radius: 70% 70% 28% 28%;
}

.product-icon--buttercroissant .product-icon-detail {
    top: 4px;
    height: 16px;
    background-color: rgba(116, 63, 35, 0.42);
}

.product-icon--cinnamonswirl,
.product-icon--cinnamonmonocle {
    width: 38px;
    height: 38px;
    border-radius: 99px;
}

.product-icon--cinnamonswirl .product-icon-detail,
.product-icon--cinnamonmonocle .product-icon-detail {
    top: 10px;
    left: 10px;
    width: 18px;
    height: 18px;
    background-color: transparent;
    border-width: 4px;
    border-color: var(--cocoa);
    border-radius: 99px;
    rotate: 0deg;
}

.product-icon--finezja .product-icon-detail {
    top: 4px;
    width: 10px;
    height: 20px;
    rotate: 0deg;
    background-color: var(--paper);
}

.product-icon--finezja .product-icon-detail--1 {
    background-color: var(--cherry);
}

.product-icon--chocolatemuffin {
    width: 38px;
    height: 31px;
    background-color: rgb(91, 53, 40);
    border-radius: 50% 50% 22% 22%;
}

.product-icon--chocolatemuffin .product-icon-detail {
    top: 5px;
    width: 6px;
    height: 6px;
    background-color: var(--glow);
    border-radius: 99px;
    rotate: 0deg;
}

.product-icon--jamturnover {
    width: 38px;
    height: 38px;
    rotate: 45deg;
    border-radius: 8px;
}

.product-icon--jamturnover .product-icon-detail {
    display: none;
}

.product-icon--chocolatepillow {
    border-radius: 8px;
}

.product-icon--chocolatepillow .product-icon-detail {
    top: 9px;
    left: 15px;
    width: 18px;
    height: 13px;
    rotate: 0deg;
    background-color: var(--cocoa);
}

.craft-heading {
    height: 34px;
    flex-direction: row;
    justify-content: space-between;
}

.craft-notebook-badge {
    width: 94px;
    height: 31px;
    margin-right: 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(244, 229, 198, 0.1);
    border-width: 1px;
    border-color: rgba(255, 180, 93, 0.28);
    border-radius: 5px;
}

.craft-notebook-spine {
    width: 8px;
    height: 100%;
    margin-right: 7px;
    background-color: var(--cherry);
    border-radius: 4px 0 0 4px;
}

.craft-notebook-label {
    color: var(--glow);
    font-size: 7px;
    letter-spacing: 0.6px;
    -unity-font-style: bold;
}

.craft-heading-copy {
    flex-grow: 1;
}

.craft-hint {
    margin-top: 3px;
    color: rgba(244, 229, 198, 0.48);
    font-size: 9px;
}

.craft-guide-hint {
    display: none;
    margin-top: 3px;
    color: var(--glow);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.clear-button {
    width: 72px;
    background-color: transparent;
    color: rgba(244, 229, 198, 0.64);
    border-width: 1px;
    border-color: rgba(244, 229, 198, 0.24);
    border-radius: 6px;
    font-size: 9px;
}

.craft-equation {
    height: 61px;
    flex-direction: row;
    align-items: center;
}

.craft-slot {
    width: 110px;
    height: 50px;
    background-color: rgba(244, 229, 198, 0.08);
    color: rgba(244, 229, 198, 0.38);
    border-width: 2px;
    border-color: rgba(244, 229, 198, 0.2);
    border-radius: 9px;
    font-size: 9px;
    white-space: normal;
}

.craft-slot--filled {
    color: var(--cocoa);
    background-color: var(--paper);
    border-color: var(--crust);
}

.equation-mark {
    width: 26px;
    color: rgba(244, 229, 198, 0.44);
    font-size: 17px;
    -unity-text-align: middle-center;
}

.equation-mark--equals {
    color: var(--glow);
    font-size: 24px;
}

.craft-result {
    flex-grow: 1;
    height: 54px;
    background-color: var(--cherry);
    color: var(--paper);
    border-width: 0;
    border-bottom-width: 5px;
    border-bottom-color: rgb(92, 45, 42);
    border-radius: 9px;
    font-size: 10px;
    letter-spacing: 0.6px;
    -unity-font-style: bold;
    white-space: normal;
}

.craft-result:disabled {
    opacity: 0.5;
    background-color: var(--sage);
}

.pantry-row {
    height: 49px;
    flex-direction: row;
}

.ingredient-card {
    flex-grow: 1;
    margin-right: 7px;
    color: var(--cocoa);
    background-color: var(--flour);
    border-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: rgb(128, 86, 56);
    border-radius: 7px;
    font-size: 9px;
    -unity-font-style: bold;
    white-space: normal;
}

.ingredient-card--milk { background-color: rgb(238, 240, 226); }
.ingredient-card--pastry { background-color: rgb(232, 195, 125); }
.ingredient-card--jam { background-color: rgb(204, 91, 86); color: var(--paper); }
.ingredient-card--chocolate { background-color: rgb(92, 57, 45); color: var(--paper); }
.ingredient-card:disabled { opacity: 0.35; }

.drag-ghost {
    display: none;
    position: absolute;
    width: 108px;
    height: 44px;
    padding: 8px;
    background-color: rgba(250, 239, 216, 0.96);
    color: var(--cocoa);
    border-width: 2px;
    border-color: var(--glow);
    border-radius: 8px;
    -unity-text-align: middle-center;
    font-size: 9px;
    -unity-font-style: bold;
}

.drag-ghost--visible {
    display: flex;
}

.work-copy {
    flex-grow: 1;
    padding-right: 13px;
}

.work-kicker {
    color: var(--cherry);
}

.work-title {
    margin-top: 5px;
    font-size: 19px;
    -unity-font-style: bold;
}

.work-detail {
    margin-top: 3px;
    font-size: 11px;
    color: rgba(56, 40, 36, 0.65);
    white-space: normal;
}

.action-progress {
    height: 6px;
    margin-top: 9px;
}

.action-progress-fill {
    background-color: var(--sage);
}

.action-button {
    width: 142px;
    background-color: var(--cherry);
    color: var(--paper);
    border-width: 0;
    border-radius: 8px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.action-button:hover,
.action-button:focus {
    background-color: rgb(190, 88, 79);
    border-bottom-width: 4px;
    border-bottom-color: var(--cocoa);
}

.action-button:disabled {
    opacity: 0.56;
    background-color: var(--sage);
}

.recipe-dock {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 16px;
    min-height: 136px;
    padding: 10px 13px 13px 13px;
    background-color: rgba(56, 40, 36, 0.95);
    border-radius: 14px;
}

.dock-heading {
    height: 22px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 5px;
    padding-right: 5px;
}

.dock-kicker {
    color: rgba(244, 229, 198, 0.76);
}

.dock-hint {
    color: rgba(244, 229, 198, 0.42);
    font-size: 8px;
    letter-spacing: 0.7px;
}

.recipe-row {
    flex-direction: row;
}

.recipe-card {
    height: 93px;
    flex-grow: 1;
    flex-basis: 0;
    margin: 3px;
    padding: 8px;
    background-color: var(--paper);
    color: var(--cocoa);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 4px;
    border-color: rgba(200, 117, 61, 0.55);
    border-bottom-color: rgb(140, 78, 45);
    border-radius: 7px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    transition-property: translate, background-color, border-color;
    transition-duration: 120ms;
}

.recipe-card:hover,
.recipe-card:focus {
    background-color: rgb(255, 246, 226);
    translate: 0 -3px;
}

.recipe-card--selected {
    translate: 0 -5px;
    border-top-width: 3px;
    border-left-color: var(--glow);
    border-right-color: var(--glow);
    border-top-color: var(--glow);
    background-color: rgb(255, 244, 217);
}

.recipe-card--locked,
.recipe-card--locked:disabled {
    opacity: 0.56;
    background-color: rgb(198, 193, 178);
    border-color: rgba(56, 40, 36, 0.34);
}
